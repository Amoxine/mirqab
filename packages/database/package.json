{
  "name": "@open-gateway/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma database client for MIRQAB",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx prisma/permissions.check.ts && tsx scripts/migrate-users-to-kratos.check.ts",
    "clean": "rm -rf node_modules .prisma dist"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "@open-gateway/config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^5.1.1",
    "prisma": "^6.5.0",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
