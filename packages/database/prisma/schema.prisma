// This is your Prisma schema file.
// Open Gateway — SaaS Admin Dashboard for Tyk OSS
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum ApiStatus {
  DRAFT
  ACTIVE
  DISABLED
  /// A non-default API version (WP16) that has been sunset. Set only on a row with `parentApiId` —
  /// the default/base version is deleted, not retired (see ApiDefinition.parentApiId). `retiredAt`
  /// carries the timestamp the `Sunset` header on `GET /apis/:id` (410) is built from.
  RETIRED
}

enum ApiSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum ApiHealthStatus {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum ApiAuthType {
  NONE
  AUTH_TOKEN
  JWT
  OAUTH
  /// Signed-request auth (WP15c): the caller signs a date header with a shared secret held on the key.
  HMAC
  /// Username/password on the key (WP15c). Weakest of the options; offered because upstreams migrating
  /// from an old proxy often still need it.
  BASIC
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum QuotaPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

/// How an API definition is expressed on the gateway. CLASSIC is Tyk's original definition format;
/// OAS is an OpenAPI 3.0 document carrying the `x-tyk-api-gateway` extension.
/// New rows default to OAS; every row that existed before WP13b was labelled CLASSIC by the
/// migration and keeps serving from its classic definition until it is explicitly re-synced.
enum ApiDefFormat {
  CLASSIC
  OAS
}

/// WP27: TCP is raw L4 passthrough on its own port (`ApiDefinition.listenPort`), bypassing the edge
/// entirely — an HTTP-only Coraza build cannot inspect it, and none of Tyk's HTTP-layer middleware
/// (auth, rate limit, quota) applies to it either (confirmed against the v5.15.0 source: the TCP
/// loader wires no HTTP middleware chain in at all). CLASSIC-format only; the OAS extension schema
/// has no TCP equivalent.
enum ApiProtocol {
  HTTP
  TCP
}

/// WP22: a developer identity's own local status — independent of ApiKeyStatus/ApiStatus, which
/// answer a different question (a key's or an API's own lifecycle, not the person's).
enum DeveloperStatus {
  ACTIVE
  SUSPENDED
}

/// WP22: a subscription's lifecycle. PENDING never has a key (Plan.requiresApproval gates the
/// APPROVED transition — see Subscription). REVOKED tears the key down; it is not reusable, a new
/// subscription is required to resume.
enum SubscriptionStatus {
  PENDING
  APPROVED
  REVOKED
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  REVOKED
  ASSIGNED
  UNASSIGNED
  LOGIN
  LOGOUT
  ROLE_CHANGED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  QUOTA_EXCEEDED
  SYNC_SUCCEEDED
  SYNC_FAILED
  /// WP19: `POST /keys/:id/rotate`.
  ROTATED
  /// WP19: `POST /keys/:id/usage/reset`.
  USAGE_RESET
  /// WP19: `PATCH /tenants/:id/quota`.
  QUOTA_UPDATED
  /// WP19: `POST /tenants/:id/quota/reset`.
  QUOTA_RESET
  /// WP18's `PUT /quotas/org` — added here alongside the WP19 values above because it was missing
  /// from this enum since WP18 landed (every one of these three writes has been silently failing).
  ORG_UPDATED
  /// WP18's `POST /quotas/org/reset`.
  ORG_RESET
  /// WP18's `POST /quotas/keys/:id/reset`.
  KEY_RESET
  /// OAS-08: a watched spec URL serves a new document (system event: no user, no correlation id).
  SPEC_UPDATE_DETECTED
}

/// OAS-08: a document fetched from an API's spec URL, proposed as its next spec version.
/// Only PENDING rows keep their text; a human applies (OAS-04) or dismisses them.
enum SpecCandidateState {
  PENDING
  APPLIED
  DISMISSED
  SUPERSEDED
}

// ─── MODELS ─────────────────────────────────────────────────────────────────

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  name             String
  password         String?
  status           UserStatus @default(ACTIVE)
  /// The Kratos identity this row shadows, set by the migration script (WP5). Kratos generates the
  /// id and refuses a supplied one, so it cannot equal `id` — and it is NOT the token subject
  /// either: Hydra's `sub` is `id`, which is what every FK and guard already keys on.
  kratosIdentityId String?    @unique @map("kratos_identity_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  userTenants UserTenant[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  /// The tenant's Tyk organisation. Every definition, policy and key this tenant owns is stamped
  /// with it, which is what makes `POST /tyk/org/keys {is_inactive:true}` cut off exactly one
  /// tenant: Tyk's OrganizationMonitor keys off the API *definition's* `org_id`, not the key's
  /// (verified on 5.15.0 — a key minted in a live org is still refused by a cut-off API).
  /// Derived once at creation as `og-<id>` (`tykOrgIdFor`); never recomputed, so it survives a
  /// rename. Enforcement needs `enforce_org_quotas` + `enforce_org_data_age` on the gateway —
  /// with either missing, the cutoff call returns 200 and does nothing.
  tykOrgId  String       @unique @map("tyk_org_id")
  status    TenantStatus @default(ACTIVE)
  plan      TenantPlan   @default(FREE)
  config    Json?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  userTenants    UserTenant[]
  apiDefinitions ApiDefinition[]
  apiKeys        ApiKey[]
  roles          Role[]
  auditLogs      AuditLog[]
  plans          Plan[]
  products       Product[]
  /// WP22: the portal's developer directory. A tenant runs one portal; a person's single Kratos
  /// identity can be at most one Developer, so it belongs to exactly one tenant's portal too.
  developers     Developer[]
  /// WP27.
  webhookSubscriptions WebhookSubscription[]
  /// WP28.
  mcpServers     McpServer[]
  apiSpecs       ApiSpec[]
  specSources    ApiSpecSource[]
  specCandidates SpecCandidate[]

  @@map("tenants")
}

model UserTenant {
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      String   @default("viewer")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id       String @id @default(uuid())
  name     String
  resource String
  action   String

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model ApiDefinition {
  id           String          @id @default(uuid())
  tenantId     String          @map("tenant_id")
  name         String
  slug         String
  tykApiId     String?         @map("tyk_api_id")
  proxyUrl     String          @map("proxy_url")
  listenPath   String          @map("listen_path")
  authType     ApiAuthType     @default(NONE) @map("auth_type")
  status       ApiStatus       @default(DRAFT)
  config       Json?
  syncStatus   ApiSyncStatus   @default(PENDING) @map("sync_status")
  syncError    String?         @map("sync_error")
  /// Per-node view of this definition across `TYK_ADMIN_URLS`, written by ReconcileService each
  /// tick: `{ checkedAt, inSync, nodes: { "<nodeUrl>": { present, hash, error? } } }`.
  /// Sits BESIDE `syncStatus` (which stays the single scalar the UI reads) rather than replacing
  /// it — one is "did our last write succeed", the other is "do the nodes agree right now".
  /// Rebuilt from the current node list every tick, never merged: a node dropped from
  /// `TYK_ADMIN_URLS` must disappear, or a decommissioned node pins `inSync:false` forever.
  syncState    Json?           @map("sync_state")
  /// Which mapper produces this API's gateway definition (WP13b). The DB default is OAS, but the
  /// migration stamped every pre-existing row CLASSIC first — a one-step `DEFAULT 'OAS'` would have
  /// relabelled live classic APIs as OAS without touching the gateway, i.e. silent data corruption.
  defFormat    ApiDefFormat    @default(OAS) @map("def_format")
  /// The OAS document last pushed for this API, stored so a drift check and the UI can show what
  /// was actually sent rather than re-deriving it. Null for CLASSIC rows and for OAS rows that have
  /// never synced.
  oasDocument  Json?           @map("oas_document")
  /// WP25's "adopt from gateway" (P2's audited escape hatch — Postgres is config of record, a node
  /// is a projection, this is how an operator overrides that on purpose). `{node, document,
  /// adoptedFields, adoptedAt}`: the raw definition READ from one node, verbatim, plus which
  /// top-level fields it carried and when. Distinct from `oasDocument` on purpose: that field is
  /// OUR OWN generated output, regenerated on every sync; this one has an external origin and is
  /// never regenerated by anything. Deliberately NOT reverse-mapped into `config`/`proxyUrl`/etc —
  /// doing so needs a full reverse of `mapToTykFormat`/`mapToTykOas`, which nothing here provides;
  /// this field is the audit-visible record of what was adopted, not a write to the structured
  /// fields a future sync reads from. Null until the first adoption.
  adoptedFromGateway Json?     @map("adopted_from_gateway")
  lastSyncedAt DateTime?       @map("last_synced_at")
  healthStatus ApiHealthStatus @default(UNKNOWN) @map("health_status")
  /// WP16: null on a plain, never-versioned API and on the default/base of a version family (it IS
  /// the parent). Set only on a CHILD version row, pointing at that family's default. A child is a
  /// full `ApiDefinition` row with its own `tykApiId`/`oasDocument` — Tyk OAS versioning models each
  /// version as its own complete definition, referenced by id from the base's
  /// `x-tyk-api-gateway.info.versioning.versions` (mapToTykOas).
  /// `onDelete: Restrict`, not Cascade: deleting the default while versions exist must answer 409
  /// (ApiService.remove), never silently take the versions with it.
  parentApiId  String?         @map("parent_api_id")
  /// WP16: this row's own version identifier (e.g. "v1", "v2"), selected via the `x-api-version`
  /// header. Null for a plain, never-versioned API. Set on BOTH the default (its own name, echoed
  /// into `info.versioning.name`/`default`) and every child, once the family's first child is
  /// created (ApiService.createVersion defaults the parent to "v1" at that point, not before — an
  /// API that never gains a version keeps this null and mapToTykOas keeps omitting `info.versioning`
  /// entirely, matching WP13b's S6 caveat 4: it has no OAS equivalent to a no-op placeholder).
  versionName  String?         @map("version_name")
  /// WP16: set when a (non-default) version is retired. `GET /apis/:id` on such a row answers 410
  /// with a `Sunset` header built from this timestamp, and the next sync of the default drops this
  /// version from `info.versioning.versions` — Tyk's own `expiration` field is NOT used for this: it
  /// answers 403 "API has expired" with no `Sunset` header (live-verified on v5.15.0), not the 410
  /// this product's contract requires.
  retiredAt    DateTime?       @map("retired_at")
  /// WP27. HTTP for everything today; TCP is the one exception (`ApiProtocol` doc comment) and is
  /// forced CLASSIC at creation — OAS has no field for it.
  protocol     ApiProtocol     @default(HTTP)
  /// WP27: only meaningful when `protocol` is TCP. Tyk opens a dedicated listener on this port as
  /// soon as the definition loads (confirmed against the v5.15.0 source — no separate enable step),
  /// gated by its port whitelist (`TYK_GW_DISABLEPORTWHITELIST`, infra/docker-compose.yml).
  /// `infra/docker-compose.yml` publishes exactly one such port straight through, bypassing the
  /// edge — this column does not manage that mapping, it only has to agree with it.
  listenPort   Int?            @map("listen_port")
  /// WP27: set by WebhookSubscriptionService, never by the tenant directly — true while this API has
  /// at least one active WebhookSubscription. Read by `mapToTykOas` to add the eventHandlers block
  /// (QuotaExceeded/AuthFailure/BreakerTripped -> this API's own internal relay). A scalar on the row
  /// being mapped, not a query the mapper runs itself, so the flag round-trips through every future
  /// sync the same way `circuitBreaker`/`rateLimit` already do. OAS-format APIs only (S1 verified
  /// `x-tyk-api-gateway.server.eventHandlers`, not the classic `event_handlers` shape) —
  /// WebhookSubscriptionService refuses to enable this on a CLASSIC row.
  webhooksEnabled Boolean      @default(false) @map("webhooks_enabled")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys              ApiKey[]
  products             ProductApi[]
  parentApi            ApiDefinition?        @relation("ApiVersions", fields: [parentApiId], references: [id], onDelete: Restrict)
  versions             ApiDefinition[]       @relation("ApiVersions")
  webhookSubscriptions WebhookSubscription[]
  /// WP28: the MCP proxies paired to this API. `Restrict` on the far side — see McpServer.
  mcpServers           McpServer[]
  specs                ApiSpec[]
  specSource           ApiSpecSource?
  specCandidates       SpecCandidate[]

  @@unique([tenantId, slug])
  // Per tenant, not global (O10). `listenPath` is what the *user* types; what reaches the gateway is
  // `/{tenant.slug}{listenPath}` (`gatewayListenPath`), and slugs are globally unique, so two tenants
  // can both own `/payments/` without either being able to capture or break the other's traffic.
  // Global uniqueness was the old defence against that and is gone: it let the first tenant to claim
  // a path squat it for everyone.
  @@unique([tenantId, listenPath])
  // A family can't have two versions with the same name. NULLs (every non-version row) are distinct
  // from each other in Postgres, so this only constrains actual children.
  @@unique([parentApiId, versionName])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([parentApiId])
  @@map("api_definitions")
}

model ApiKey {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  userId    String       @map("user_id")
  name      String
  tykKeyId  String?      @map("tyk_key_id")
  keyHash   String?      @map("key_hash")
  status    ApiKeyStatus @default(ACTIVE)
  expiresAt DateTime?    @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")

  /// WP18: when set, the key's limits come from this plan's Tyk policy (`apply_policies`) and the
  /// key itself carries no inline `rate`/`quota_max`. Null keeps the pre-WP18 behaviour — inline
  /// limits on the key — so existing keys keep working untouched.
  planId String? @map("plan_id")

  /// WP18 fix, live-verified against Tyk 5.15.0: a plan's own policy is deliberately ACL-less
  /// (`partitions.acl: false`, shared across every key on the plan — see `Plan`'s doc comment), but
  /// `apply_policies` still requires SOME referenced policy to own ACL or `/tyk/keys/create` refuses
  /// the key outright. This is that policy: one per plan-governed key, `partitions.acl: true`,
  /// carrying this key's real `access_rights` so its API scope survives being paired with an
  /// ACL-less plan policy. Null for a pre-fix or non-plan key. Lifecycle tied to the key: created
  /// alongside it, deleted alongside it — see `KeyService`.
  tykAclPolicyId String? @map("tyk_acl_policy_id")

  /// WP28: the MCP server this key may call, when it is an MCP key. Independent of `apiDefId` —
  /// an MCP proxy is its own gateway API with its own credential, deliberately NOT the source REST
  /// API's (Tyk treats the proxy as a separate consumer of that API). Which TOOLS the key may call
  /// is not stored here: it is derived from the key's plan against `McpServer.tools[].planId`
  /// (see `mcpToolGrants`), so re-binding a tool to a different plan changes access without
  /// rewriting a single key row.
  mcpServerId String? @map("mcp_server_id")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiDef   ApiDefinition? @relation(fields: [apiDefId], references: [id], onDelete: SetNull)
  apiDefId String?        @map("api_def_id")
  /// SetNull for the same reason as `plan`: deleting an MCP server must not destroy live credentials.
  mcpServer McpServer?    @relation(fields: [mcpServerId], references: [id], onDelete: SetNull)
  /// SetNull, not Cascade: deleting a plan must not delete the customer's keys. They fall back to
  /// unlimited-by-policy and are visible as plan-less in the UI, which is recoverable; deleting
  /// live credentials because a commercial plan was retired is not.
  plan     Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  quotas   Quota[]

  @@index([planId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([apiDefId])
  @@index([mcpServerId])
  @@map("api_keys")
}

/// An MCP (Model Context Protocol) server this tenant publishes (WP28).
///
/// It is NOT a second kind of API definition: on the gateway it is a **REST-as-MCP proxy**, a
/// separate object with its own lifecycle under `/tyk/mcps` — Tyk's `/tyk/apis` CRUD cannot create
/// or delete it. The proxy is *paired* to exactly one source `ApiDefinition`, which must be
/// OAS-format and already synced: Tyk synthesises the MCP server from that API's OpenAPI document
/// (`upstream.url = tyk://<sourceTykApiId>/mcp`) and translates each `tools/call` into the REST
/// operation the tool names. The source API is never modified.
///
/// Pairing is org-scoped by the gateway itself — "Paired REST API belongs to a different OrgID",
/// live-verified on v5.15.0 — so the tenant isolation `Tenant.tykOrgId` already provides extends to
/// MCP for free, and a cross-tenant pairing is refused by the gateway even if this row's own
/// tenant check were ever bypassed.
model McpServer {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  /// The paired REST API. `Restrict`, not Cascade or SetNull: an MCP proxy with no source is not a
  /// degraded proxy, it is a definition the gateway refuses to load. Delete the proxy first.
  sourceApiId String        @map("source_api_id")
  name        String
  slug        String
  /// What the user types; what reaches the gateway is `/{tenant.slug}{listenPath}`, exactly as for
  /// an ApiDefinition. The MCP endpoint itself is `POST {listenPath}/mcp` — streamable HTTP is the
  /// only transport Tyk 5.15.0 serves for an MCP proxy.
  listenPath  String        @map("listen_path")
  /// `McpToolDto[]`: which source operations are exposed as MCP tools, each with its optional
  /// per-primitive rate limit and its optional plan binding (TBAC). Stored as one JSON column
  /// rather than a child table because a tool is never read, written or synced on its own — the
  /// whole definition is re-pushed to the gateway on every change.
  tools       Json          @default("[]")
  tykApiId    String?       @unique @map("tyk_api_id")
  status      ApiStatus     @default(ACTIVE)
  syncStatus  ApiSyncStatus @default(PENDING) @map("sync_status")
  syncError   String?       @map("sync_error")
  lastSyncedAt DateTime?    @map("last_synced_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceApi ApiDefinition @relation(fields: [sourceApiId], references: [id], onDelete: Restrict)
  apiKeys   ApiKey[]

  @@unique([tenantId, slug])
  @@unique([tenantId, listenPath])
  @@index([tenantId])
  @@index([sourceApiId])
  @@map("mcp_servers")
}

/// OAS-01: the OpenAPI document an API was imported from, one row per submitted version. The source
/// text is kept VERBATIM (its SHA-256 is `contentHash`, so a re-upload of the same bytes is
/// recognisable) and `endpointIndex` is computed once at import, so listing endpoints never
/// re-parses a document of up to 5 MB. This is NOT `ApiDefinition.oasDocument`, which is the
/// Tyk-OAS document the sync path GENERATES and overwrites on every sync.
model ApiSpec {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  apiDefId       String   @map("api_def_id")
  /// 1, 2, 3 … per API. Immutable rows: a new upload is a new row, never an update.
  versionNo      Int      @map("version_no")
  contentHash    String   @map("content_hash")
  /// 'json' or 'yaml' — how the source text was written, for download and for display.
  format         String
  openapiVersion String   @map("openapi_version")
  sourceText     String   @map("source_text")
  /// [{ key, method, path, operationId, summary, tags, deprecated, securitySchemes }] — see
  /// `oas-endpoints.ts`. Bounded by MAX_ENDPOINTS at import.
  endpointIndex  Json     @map("endpoint_index")
  endpointCount  Int      @map("endpoint_count")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiDef ApiDefinition @relation(fields: [apiDefId], references: [id], onDelete: Cascade)

  @@unique([apiDefId, versionNo])
  @@index([tenantId, apiDefId])
  @@map("api_specs")
}

/// OAS-08: the URL an API's OpenAPI document is watched at (at most one per API). `url` may carry a
/// secret in its query string: it is returned redacted, never logged, and redacted in audit details.
/// Stored plain, like webhook receiver URLs (there is no secret store).
model ApiSpecSource {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  apiDefId            String    @unique @map("api_def_id")
  url                 String
  enabled             Boolean   @default(true)
  /// 15, 60, 360 or 1440 (the PUT DTO enforces the set).
  intervalMinutes     Int       @map("interval_minutes")
  /// Advanced BEFORE each network call (the claim), so a crash mid-check retries next interval.
  nextCheckAt         DateTime  @map("next_check_at")
  /// Set when a check is claimed; also the 30 s "check now" cooldown.
  lastCheckedAt       DateTime? @map("last_checked_at")
  lastSuccessAt       DateTime? @map("last_success_at")
  /// 'UNCHANGED' | 'CHANGED' | 'ERROR'
  lastResult          String?   @map("last_result")
  /// A fixed code (SPEC_FETCH_* / NOT_A_SPEC), never remote text.
  lastErrorCode       String?   @map("last_error_code")
  /// Stored only after the gates passed, so an ERROR is not masked by a later 304.
  etag                String?
  lastModified        String?   @map("last_modified")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiDef ApiDefinition @relation(fields: [apiDefId], references: [id], onDelete: Cascade)

  @@index([enabled, nextCheckAt])
  @@index([tenantId])
  @@map("api_spec_sources")
}

/// OAS-08: a document a spec URL served that differs from the API's applied version. Shown as
/// "update available" only while PENDING and different from the latest `api_specs` hash (read-time
/// rule). No unique (api_def_id, content_hash): content A can come back after B and be proposed again.
/// The last 20 per API are kept.
model SpecCandidate {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  apiDefId       String             @map("api_def_id")
  contentHash    String             @map("content_hash")
  format         String
  openapiVersion String             @map("openapi_version")
  /// Kept only while PENDING; NULL once applied, dismissed or superseded.
  sourceText     String?            @map("source_text")
  endpointCount  Int                @map("endpoint_count")
  /// The applied versionNo the diff was computed against. Display only: apply re-diffs.
  baseVersionNo  Int                @map("base_version_no")
  /// { added, removed, changed, governedRemoved, governedChanged } counts at detection time.
  diffSummary    Json               @map("diff_summary")
  /// Lint warnings at detection time (a document with errors never becomes a candidate).
  findings       Json
  state          SpecCandidateState @default(PENDING)
  detectedAt     DateTime           @default(now()) @map("detected_at")
  decidedAt      DateTime?          @map("decided_at")
  decidedBy      String?            @map("decided_by")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiDef ApiDefinition @relation(fields: [apiDefId], references: [id], onDelete: Cascade)

  @@index([apiDefId, contentHash])
  @@index([tenantId, state])
  @@map("spec_candidates")
}

/// A commercial plan (WP18): one Tyk policy, shared by every key assigned to it.
///
/// The point of the indirection is that editing a plan changes the effective limit for all its
/// keys without touching a single key — Tyk resolves `apply_policies` at request time, so the
/// policy is the single source of the rate and quota and the key carries none of its own.
///
/// **`Plan.id` IS the Tyk policy id.** No separate column, because a second identifier is a second
/// thing to keep in sync; `apply_policies: [plan.id]` is then literally true. Safe because the
/// gateway runs with `allow_explicit_policy_id`, and the other two policy-id shapes in this system
/// are distinguishable by construction: JWT policies are `og-jwt-<apiDefId>` and an OAuth2 client's
/// policy id is its Hydra client id.
model Plan {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String
  description String?

  /// Requests per `per` seconds. 0 disables rate limiting (Tyk's own convention, matching
  /// `buildJwtPolicy`), it does not mean "block everything".
  rate Int @default(0)
  per  Int @default(1)

  /// Requests per `quotaPeriod`. **-1 is unlimited**, again Tyk's convention — 0 would mean a
  /// quota of zero requests, which is not the same thing and is not what an unset plan wants.
  quotaMax    Int         @default(-1) @map("quota_max")
  quotaPeriod QuotaPeriod @default(MONTHLY) @map("quota_period")

  active    Boolean  @default(true)
  /// WP22: a self-service subscription to this plan is created PENDING and issues no key
  /// (`Subscription`); one still requires nothing further to APPROVE otherwise. Default false
  /// (self-service, matching the WP22 happy path) — flip per plan for the ones a tenant wants to
  /// gate on manual review. There is no admin-approve endpoint yet (not required by any acceptance
  /// criterion this WP was given); a PENDING subscription just stays PENDING until one exists.
  requiresApproval Boolean @default(false) @map("requires_approval")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  /// Restrict, not the ApiKey relation's SetNull: a subscription's key is built from BOTH this
  /// plan's policy and the product's ACL policy (see Subscription) — there is no "fall back to
  /// unlimited" state for a portal-issued key the way a dashboard key has. Revoke the subscriptions
  /// first.
  subscriptions Subscription[]

  /// Unique per tenant, not globally: two tenants may both call a plan "Gold".
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("plans")
}

/// A bundle of APIs published together (WP18). Purely a grouping in the control plane — it has no
/// gateway object of its own; the APIs it names are what a developer is granted access to.
model Product {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String
  slug        String
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apis          ProductApi[]
  /// WP22: Restrict — the product IS the access grant a subscription's key was built from
  /// (`accessRightsFor`, extended to the product's whole API set). Revoke the subscriptions first.
  subscriptions Subscription[]

  /// Both unique per tenant, for the same reason as `Plan.name` (O10's per-tenant keying).
  @@unique([tenantId, slug])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("products")
}

/// Product <-> ApiDefinition join. Cascades from both sides: deleting either end removes the
/// membership, never leaving a row pointing at something that is gone.
model ProductApi {
  productId String   @map("product_id")
  apiDefId  String   @map("api_def_id")
  createdAt DateTime @default(now()) @map("created_at")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  apiDef  ApiDefinition @relation(fields: [apiDefId], references: [id], onDelete: Cascade)

  @@id([productId, apiDefId])
  @@index([apiDefId])
  @@map("product_apis")
}

/// A self-service developer (WP22) — the portal's identity, distinct from the dashboard's `User`.
/// Both shadow a Kratos identity (`kratosIdentityId`), but there is no discriminator trait on the
/// Kratos side (`identity.schema.json` is unchanged): "which one" is answered by which table has a
/// row for that identity, checked by `DeveloperAuthGuard`/`AuthService` in their own domains and
/// never both — a Kratos session that resolves to a Developer is refused by every dashboard route
/// (JwtAuthGuard only accepts a Hydra-issued JWT, a different token format entirely) and vice versa.
///
/// **Carries `tenantId`.** The portal is one catalog per tenant; every `Application`/`Subscription`
/// this developer owns is reached only through this row, never by a bare id a caller supplied —
/// that is what makes a cross-tenant catalog impossible rather than merely unlikely (see the plan's
/// own ladder justification for this WP).
model Developer {
  id               String          @id @default(uuid())
  tenantId         String          @map("tenant_id")
  email            String
  name             String
  kratosIdentityId String          @unique @map("kratos_identity_id")
  status           DeveloperStatus @default(ACTIVE)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications Application[]

  /// Kratos itself already enforces one identity per email globally (the schema's `identifier: true`
  /// email trait) — `kratosIdentityId`'s own uniqueness is what that constraint shows up as here.
  /// This index is for the tenant-scoped lookup and dev-facing conflict messages, not a second
  /// source of the guarantee.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("developers")
}

/// A developer's registered application (WP22) — the unit a `Subscription` belongs to. Plain
/// registration record; it mints no gateway credential of its own. What a subscription grants
/// access to (which APIs) and at what tier (rate/quota) is `Product`/`Plan`'s job, reused as-is —
/// see `Subscription`'s doc comment for why this WP does not also wire Hydra client credentials
/// onto it.
model Application {
  id          String   @id @default(uuid())
  developerId String   @map("developer_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  developer     Developer      @relation(fields: [developerId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([developerId, name])
  @@index([developerId])
  @@map("applications")
}

/// An application's grant to one product at one plan tier (WP22) — the thing that actually issues
/// a Tyk key. Reuses WP18's two-policy pattern exactly: the PLAN's own policy carries rate/quota
/// (`buildPlanPolicy`, ACL-less by design) and a per-subscription ACL policy
/// (`accessRightsFor`/`buildKeyAclPolicy`, extended to accept every API the PRODUCT bundles rather
/// than a single one) carries the actual access grant, `apply_policies: [planId, aclPolicyId]`.
///
/// PENDING mints no key at all — not a key nobody can use, an absent one, which is what "an
/// unapproved subscription issues no key" means literally. `Plan.requiresApproval` decides whether
/// creating a subscription lands PENDING or is approved (and its key issued) in the same call.
model Subscription {
  id             String             @id @default(uuid())
  applicationId  String             @map("application_id")
  productId      String             @map("product_id")
  planId         String             @map("plan_id")
  status         SubscriptionStatus @default(PENDING)
  tykKeyId       String?            @map("tyk_key_id")
  keyHash        String?            @map("key_hash")
  /// Same purpose as `ApiKey.tykAclPolicyId` (WP18 fix): a plan's own policy is deliberately
  /// ACL-less and shared, so a second, per-subscription policy carries this subscription's real
  /// access rights. Lifecycle tied to this row: created alongside its key, deleted alongside it.
  tykAclPolicyId String?            @map("tyk_acl_policy_id")
  approvedAt     DateTime?          @map("approved_at")
  revokedAt      DateTime?          @map("revoked_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Restrict: the product is the access grant this subscription's key was built from — deleting it
  /// out from under a live key would leave the key's own access_rights the only record of what it
  /// was ever allowed to reach. Revoke the subscription first.
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Restrict, matching product: the plan is half of this subscription's key (rate/quota via
  /// `apply_policies`). SetNull (ApiKey's pattern) would silently drop the limit from a live key
  /// instead of making the tenant decide what replaces it.
  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)

  /// One subscription per (application, product) — re-subscribing means changing the plan on the
  /// existing row, not creating a second grant to the same product.
  @@unique([applicationId, productId])
  @@index([applicationId])
  @@index([productId])
  @@index([planId])
  @@map("subscriptions")
}

model Quota {
  id        String      @id @default(uuid())
  apiKeyId  String      @map("api_key_id")
  limit     Int
  used      Int         @default(0)
  period    QuotaPeriod @default(MONTHLY)
  resetAt   DateTime    @map("reset_at")
  createdAt DateTime    @default(now()) @map("created_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([resetAt])
  @@map("quotas")
}

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  tenantId  String?     @map("tenant_id")
  userId    String?     @map("user_id")
  action    AuditAction
  resource  String
  details   Json?
  ipAddress String?     @map("ip_address")
  corrId    String?     @map("correlation_id")
  createdAt DateTime    @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@index([resource])
  @@map("audit_logs")
}

/// WP27. A tenant's receiver for one API's native Tyk webhook events (QuotaExceeded, AuthFailure,
/// BreakerTripped — see `ApiDefinition.webhooksEnabled`). Deliveries do not reach `receiverUrl`
/// directly: Tyk fires at this platform's own internal relay (`webhook-relay.constants.ts`), which
/// redacts the raw key Tyk's default payload carries (S1 caveat 3), HMAC-signs the redacted body
/// with `secret`, and retries — the parts native Tyk webhooks cannot do at all.
model WebhookSubscription {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  apiId       String   @map("api_id")
  receiverUrl String   @map("receiver_url")
  /// Signing secret, `randomBytes(32).toString('base64url')` — same one-time-return contract as a
  /// Tyk key (`tyk-client.service.ts:186-196`): given back in the create response and never again.
  secret String
  active Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  api    ApiDefinition @relation(fields: [apiId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@index([apiId])
  @@map("webhook_subscriptions")
}

enum WebhookDeliveryStatus {
  SUCCESS
  FAILED
}

/// WP27. One row per relay attempt-set (not per HTTP try — `attempts` counts those), written after
/// the retry loop settles so the log always reflects a final outcome.
model WebhookDelivery {
  id             String                @id @default(uuid())
  subscriptionId String                @map("subscription_id")
  eventType      String                @map("event_type")
  attempts       Int                   @default(1)
  status         WebhookDeliveryStatus
  responseStatus Int?                  @map("response_status")
  error          String?
  createdAt      DateTime              @default(now()) @map("created_at")

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("webhook_deliveries")
}

// tyk_analytics / tyk_aggregated (Tyk Pump-owned tables) are deliberately NOT modeled here.
// They're read via raw SQL only (apps/api/.../pump-query.builder.ts uses $queryRaw against
// public.tyk_analytics/tyk_aggregated with to_regclass presence checks). Modeling them previously
// was based on a misunderstanding: `prisma migrate diff --from-empty` emits CREATE TABLE DDL for
// them regardless of `@@ignore` (which only drops a model from the generated Client, not from
// diff/migrate), so the next `migrate dev` would write that DDL into a migration and fail
// `migrate deploy` wherever Pump already created these tables. Do not re-add them.
//
// Consequence of leaving them unmodeled: `prisma migrate status` stays clean (it only compares
// migration history to the schema), but a bare `prisma migrate dev` diffs the schema against the
// live DB and WILL see these two tables as drift, then offer to reset the database — never accept
// that, it destroys Pump's data. If schema.prisma needs a real change, use
// `prisma migrate dev --create-only`, hand-edit the generated migration to touch only what you
// actually changed, then `prisma migrate deploy` (same convention already used elsewhere in this
// project, see .omc/plans/autopilot-impl.md). Never run `migrate reset` / `db push --force-reset`.
