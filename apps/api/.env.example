# ─── Server ──────────────────────────────────────────────
PORT=33001
NODE_ENV=development

# ─── Database ────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname?schema=public
DATABASE_URL="postgresql://opengateway:opengateway@localhost:33002/opengateway?schema=public"

# ─── Redis ───────────────────────────────────────────────
# Redis connection string
# Format: redis://[:password@]host[:port][/db-number]
REDIS_URL="redis://localhost:33003"

# ─── JWT / Auth ─────────────────────────────────────────
# Unused since the Ory cutover (WP2): this API no longer signs or verifies its own tokens. Kept only
# until WP7 removes it from infra/docker-compose.yml and install.sh.
JWT_SECRET=""
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Ory (Hydra / Kratos / Keto) ────────────────────────
# Access tokens are issued by Hydra and verified against its JWKS. ISSUER is the `iss` claim Hydra
# stamps (urls.self.issuer in infra/ory/hydra/hydra.yml) — the browser-facing URL, NOT the host the
# JWKS is fetched from. The values below are for running the API OUTSIDE compose; inside compose the
# service names are used instead (see infra/docker-compose.yml).
ORY_HYDRA_PUBLIC_URL=http://localhost:33010
ORY_HYDRA_ADMIN_URL=http://localhost:33011
ORY_HYDRA_ISSUER=http://localhost:33010/
ORY_KRATOS_PUBLIC_URL=http://localhost:33012
ORY_KRATOS_ADMIN_URL=http://localhost:33013
# Keto answers tenant membership: read = check, write = relation tuples.
ORY_KETO_READ_URL=http://localhost:33014
ORY_KETO_WRITE_URL=http://localhost:33015

# ─── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:33000

# ─── Session cookies ────────────────────────────────────
# Secure flag on access_token/refresh_token. 'true' | 'false'; unset = true only when
# NODE_ENV=production. Set it to true when TLS is terminated in front of the API but NODE_ENV is not
# production (e.g. the compose stack behind nginx), otherwise the cookies go out without Secure.
# Leave it false/unset on plain http://localhost — browsers drop Secure cookies over http.
# COOKIE_SECURE=

# ─── Reverse proxy / rate limiting ──────────────────────
# Number of reverse proxies in front of the API (Express `trust proxy` hop count), integer >= 0.
# Rate limits are per client IP: 100 requests/min globally (1000/min when NODE_ENV is not
# production) and 5/min on login and register. With 0 (default) X-Forwarded-For is ignored, so behind
# a proxy every client shares the proxy's bucket. Set it to the exact hop count (1 for a single
# nginx/ingress); too high lets clients spoof X-Forwarded-For and dodge the limits. Invalid = 0.
TRUST_PROXY_HOPS=0

# ─── Tyk Integration ────────────────────────────────────
# Tyk OSS Gateway REST API: <gateway>/tyk. No Tyk Dashboard.
# The gateway serves its control API (/tyk/*) on TYK_GW_CONTROLAPIPORT (8081 in compose), which is NOT
# published to the host — port 33005 is the data plane only. In compose: http://tyk-gateway:8081/tyk
TYK_ADMIN_URL=
# Gateway secret (TYK_GW_SECRET on the gateway) — NEVER log or expose this
TYK_ADMIN_SECRET=
# Base URL for the GET /hello health probe. With a control port configured, /hello is served THERE,
# not on the data port (verified on Tyk 5.15.0), so in compose: http://tyk-gateway:8081
TYK_GATEWAY_URL=
# Tyk Organization ID
# TYK_ORG_ID was removed in WP12c: the Tyk org is per tenant (`Tenant.tykOrgId`), not one
# gateway-wide value. Nothing reads this any more.

# ─── Upstream (proxyUrl) denylist ────────────────────────
# Extra hosts an API may never proxy to, comma separated (e.g. vault.internal,10.1.2.3).
# Always refused, with or without this: loopback (localhost, 127.0.0.0/8, ::1, 0.0.0.0), link-local and
# cloud metadata (169.254.0.0/16, fe80::/10, metadata, metadata.google.internal) and the platform's own
# services (tyk-gateway, tyk-pump, postgres, redis). Internal service names such as `api` or
# `my-backend`, public hosts and RFC1918 addresses stay ALLOWED — self-hosted upstreams are the point.
# This is a denylist, not full SSRF protection: DNS rebinding and public names that resolve to private
# addresses are out of scope.
PROXY_DENY_HOSTS=

# ─── Analytics pipeline ──────────────────────────────────
# Tyk Pump liveness probe (its /health endpoint, port 8083). Inside docker compose use
# http://tyk-pump:8083/health. Empty/unreachable = analytics report "pump not running" and
# `pipelineReady=false`. The pump port is not published to the host, so it stays unreachable
# when the API runs outside compose unless you publish 8083 yourself.
PUMP_HEALTH_URL=

# ─── Analytics retention (Tyk Pump tables) ───────────────
# Daily cron trims the pump-owned tables. Raw rows are per-request and unbounded; the hourly
# aggregate is small enough to keep for a year.
ANALYTICS_RETENTION_DAYS=30
ANALYTICS_AGGREGATE_RETENTION_DAYS=365

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug

# ─── OpenTelemetry ───────────────────────────────────────
OTEL_SERVICE_NAME=open-gateway-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
