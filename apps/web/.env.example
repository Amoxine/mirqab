# The five application ports are HTTPS behind the Caddy edge (WP26b). Install its CA root once
# per machine, or point Node at it: export NODE_EXTRA_CA_CERTS=$PWD/infra/edge/root.crt
# See infra/edge/README.md.
# Application
NEXT_PUBLIC_APP_URL=https://localhost:33000
NEXT_PUBLIC_API_URL=https://localhost:33001

# Ory (browser-facing)
NEXT_PUBLIC_KRATOS_URL=https://localhost:33012
NEXT_PUBLIC_HYDRA_URL=https://localhost:33010

# Gateway data plane (WP23) — the portal's try-it console calls it directly from the browser
NEXT_PUBLIC_GATEWAY_URL=https://localhost:33005

# Ory (this server's own outbound calls — in Docker the code defaults to hydra:/kratos: instead)
HYDRA_PUBLIC_URL=https://localhost:33010
HYDRA_ADMIN_URL=http://127.0.0.1:33011
KRATOS_INTERNAL_URL=https://localhost:33012

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_WEBSOCKETS=false
# Invite by email: shows the offer in the invite sheet. HELD BACK (security finding H1), off unless
# exactly 'true'. MUST MATCH the api's FEATURE_INVITE_BY_EMAIL (apps/api/.env.example), which decides
# whether the route exists at all. Inlined at build time: rebuild after changing it.
# NEXT_PUBLIC_FEATURE_INVITE_BY_EMAIL=false
