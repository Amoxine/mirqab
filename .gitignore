# Docker
docker-compose.override.yml

# Edge CA root — exported per install from the caddy_data volume (infra/edge/README.md). Never
# committed: the matching private key lives on whichever machine booted the stack, so a committed
# root asks every other machine to trust a CA someone else holds the key to.
infra/edge/root.crt

# Documentation
docs/*.png
docs/*.jpg

# Backup files
*.bak
*.backup

# Temporary files
*.tmp
*.temp
.cache/

# Local run artifacts (installer logs, agent scratch state)
.install-logs/
.sisyphus/

# TypeScript incremental build state (stale copies caused partial dist output)
*.tsbuildinfo
