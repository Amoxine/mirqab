# Production environment for infra/docker-compose.yml + infra/docker-compose.prod.yml.
# Runbook: docs/go-live.md.
#
#   test -e infra/.env && echo 'infra/.env already exists: edit it, do not overwrite' \
#     || { cp -n infra/.env.production.example infra/.env && chmod 600 infra/.env; }
#
# NEVER overwrite an existing infra/.env. On a host that already runs the stack it holds the live
# DB_PASS, the Ory secrets and the cipher, and replacing them with fresh ones is the migration
# described below, not a refresh. Copy only the variables it is missing.
#
# Every value below is EMPTY on purpose, and that is load-bearing: compose refuses an empty `${VAR:?}`
# and infra/scripts/prod-preflight.sh rejects it, so a variable nobody filled in stops the deploy
# instead of being used. A "change-me" placeholder would be accepted as the real value.
#
# Do not reuse the infra/.env that install.sh wrote on a laptop: it carries development choices
# (EDGE_LAN_IP, a TYK_GW_SECRET of unknown strength) and its secrets have been on a dev machine.
# Generate fresh ones here, once. Replacing DB_PASS, the Hydra/Kratos secrets or KRATOS_SECRETS_CIPHER
# on a live deployment is a migration, not an edit: the Postgres volume keeps the password it was
# initialised with, and data signed or encrypted with the old Ory secrets stops verifying.
#
# NOT in this file, on purpose:
#   COMPOSE_PROFILES  `dev` starts the Mailpit mail sink. install.sh writes it into a laptop's infra/.env;
#                     a server must not have it (infra/scripts/check-prod-ports.sh fails on it).
#   ADMIN_EMAIL and ADMIN_PASSWORD, the first super_admin. They are read by the seed
#                     only (packages/database/prisma/seed.ts requires them unless NODE_ENV is a literal
#                     development or test) and are passed to that one-off container from your shell, so
#                     the password never sits in a long-lived file. See docs/go-live.md, step 7.

# ─── Required: secrets (compose or prod-preflight stops the deploy if one is empty) ─────────────────

# Shared Postgres password (app database and the Hydra/Kratos/Keto DSNs). No whitespace: it is also
# spliced into the pump's libpq connection string, where a space ends the value.
#   openssl rand -hex 16
DB_PASS=

# Required by compose, but dead since the Ory cutover: its only reader is a deprecated module with no
# caller (apps/api/src/modules/auth/jwt-secret.ts). Still generate a real one.
#   openssl rand -hex 32
JWT_SECRET=

# The control-API credential for every Tyk node (x-tyk-authorization). prod-preflight rejects the
# committed default `tyk-gateway-secret`, anything under 32 characters, and any whitespace.
#   openssl rand -hex 32
TYK_GW_SECRET=

# Tyk's event handler presents this to the api's public relay endpoint; it is what separates a real
# Tyk event from a forged one, and that endpoint is reachable through the edge.
#   openssl rand -hex 32
TYK_WEBHOOK_RELAY_SECRET=

# Redis `--requirepass`, and the same value for the api, the three gateway nodes, the pump and the
# exporter. prod-preflight also proves Redis answers NOAUTH to an unauthenticated PING.
#   openssl rand -hex 32
REDIS_PASSWORD=

# Password of the read-only `og_monitor` role postgres-exporter logs in as. At least 32 characters.
#   openssl rand -hex 32
PG_EXPORTER_PASSWORD=

# Ory Hydra.
#   openssl rand -hex 32
HYDRA_SECRETS_SYSTEM=
#   openssl rand -hex 32
HYDRA_SECRETS_COOKIE=

# Ory Kratos. The cipher must be EXACTLY 32 characters (16 random bytes as hex); Kratos refuses to
# start otherwise.
#   openssl rand -hex 32
KRATOS_SECRETS_DEFAULT=
#   openssl rand -hex 32
KRATOS_SECRETS_COOKIE=
#   openssl rand -hex 16
KRATOS_SECRETS_CIPHER=

# ─── Required: deployment inputs (no safe default exists — see docs/go-live.md, "Inputs") ───────────

# A real SMTP server for Kratos recovery and verification mail. The base file's default is the
# dev-only Mailpit, which production does not run; prod-preflight rejects that address and loopback
# hosts. smtps:// (implicit TLS, usually :465) or smtp:// with STARTTLS (:587). URL-encode any special
# character in the username or password. The sender is `courier.smtp.from_address` in
# infra/ory/kratos/kratos.yml — it must be a domain this provider may send for (SPF/DKIM).
#   smtps://<user>:<password>@<smtp-host>:465/
KRATOS_SMTP_URI=

# The digest-pinned edge image CD published. A tag is rejected, and so is a malformed digest.
# CD writes this line itself on the staging host (infra/scripts/deploy-staging.sh). For a manual
# deploy:
#   docker buildx imagetools inspect ghcr.io/<owner>/<repo>/edge:<tag> --format '{{.Manifest.Digest}}'
# then   EDGE_IMAGE=ghcr.io/<owner>/<repo>/edge@sha256:<64 hex>
EDGE_IMAGE=

# ─── Strongly recommended ───────────────────────────────────────────────────────────────────────────

# Kratos session cookie `Secure` flag. The base file defaults it to false (the stack was once plain
# HTTP); the production overlay defaults it to true, and prod-preflight FAILS on anything but `true`.
# Written out here so the intent is visible.
KRATOS_COOKIE_SECURE=true

# ─── Optional (leave empty to take the compose default) ─────────────────────────────────────────────

# Prebuilt application images; empty means compose builds from the checkout on the host. CD writes
# both next to EDGE_IMAGE. Pin by digest: ghcr.io/<owner>/<repo>/{api,web}@sha256:<64 hex>
API_IMAGE=
WEB_IMAGE=

# Nodes the edge load-balances (space separated, host:port) and the control URLs the api fans writes
# out to (comma separated). The overlay defaults name all three nodes; set these only for a different
# topology, and keep the two lists describing the same nodes.
EDGE_GATEWAY_UPSTREAMS=
TYK_ADMIN_URLS=

# The host's LAN address, so the edge's `tls internal` CA also issues for https://<ip>:<port>.
# Irrelevant once real certificates replace `tls internal` (docs/go-live.md).
EDGE_LAN_IP=

# Private hosts or CIDRs the api may fetch OpenAPI documents from (comma separated, host[:port] or
# CIDR[:port]). Empty means public hosts only. Installation-wide: every tenant can reach every host
# listed. docs/OAS-SPEC-FETCH.md.
SPEC_FETCH_ALLOWED_HOSTS=

# Where each gateway node runs, for the dashboard's map: a JSON object, single-quoted here. The shape
# is documented in apps/web/src/lib/gateway-locations.ts. Empty means the map shows no pins. Baked
# into the web image at BUILD time (a build arg), so changing it needs a rebuild, not a restart.
NEXT_PUBLIC_GATEWAY_NODE_LOCATIONS=

# Postgres base-backup interval in seconds (default 86400) and how many to keep (default 7). Backups
# live in the pg_backups volume on this same host — see docs/go-live.md for what that does not cover.
PG_BACKUP_INTERVAL=
PG_BACKUP_KEEP=

# Prometheus retention cap (default 4GB) and the address node-exporter binds (default the docker0
# gateway, 172.17.0.1:9100; set it if the daemon uses a non-default bridge IP).
PROM_RETENTION_SIZE=
NODE_EXPORTER_LISTEN_ADDRESS=
