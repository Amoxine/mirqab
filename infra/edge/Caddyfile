# MIRQAB edge — TLS termination + WAF (WP26b).
#
# One Caddy, five HTTPS listeners on the port numbers the stack already published. Nothing else
# publishes any more (`expose:` in docker-compose.yml), which is what closes the bypass where a LAN
# client reached Tyk directly on 33005 and forged its own X-Forwarded-For.
#
# Base URLs after the cutover are yesterday's URLs with http -> https and the SAME port:
#   https://localhost:33000  web        https://localhost:33010  Hydra public
#   https://localhost:33001  api        https://localhost:33012  Kratos public
#   https://localhost:33005  gateway data plane
#
# One issuance mode, `tls internal`: Caddy's own CA signs for `localhost` and for the host's LAN IP.
# No hostname is invented, so there is no DNS and no *.lan question. Export the root once and trust
# it on each client (see infra/edge/README.md) — after that `curl` needs no -k.
#
# NOT routed here, deliberately, and a request for any of them through the edge gets a 404 from
# Caddy's default handler: the Tyk control API (8081), Prometheus (9090, arrives with WP20) and the
# Ory admin APIs (33011/33013, loopback-only and unauthenticated). Adding a site for any of those
# publishes an unauthenticated admin surface to the LAN.
#
# This file is operator configuration. It has no UI, no API route and no permission — an edge route
# table a tenant admin can edit is a tenant admin who can re-point the control plane.
{
	# Mandatory for coraza-caddy: the WAF must evaluate before any other handler runs.
	order coraza_waf first

	# OG-OBS-02: turns on Caddy's built-in HTTP request-metrics collection (duration, size, status
	# code, per-server totals). This only enables collection — nothing is published anywhere until a
	# site declares its own `metrics` handler, which the internal listener below does. `per_host` is
	# deliberately NOT set: with 5 TLS sites plus the catch-all, a per-host label would multiply every
	# series 6x for no operational reason at this scale.
	metrics

	# What makes https://<lan-ip>:<port> work at all. A client dialling an IP literal sends NO SNI
	# (RFC 6066 allows host names only — curl, openssl and browsers all omit it), and without a
	# default Caddy has nothing to select a certificate by: the handshake dies with
	# "tlsv1 alert internal error". Harmless for `localhost`, which always arrives with SNI set.
	# This is a GLOBAL option, not a `tls` subdirective — `tls internal { default_sni ... }` is a
	# startup error ("unknown subdirective").
	default_sni {$EDGE_LAN_IP:127.0.0.1}

	log {
		output stdout
		format json
	}

	# WP20: the per-rule WAF detections are MOVED to a file on a volume the otel-collector tails
	# (`filelog` -> `count` -> Prometheus, observability/otel-collector.yaml).
	#
	# Moved, not copied — `include` takes a logger away from the default log rather than teeing it.
	# Measured on this build: `docker compose logs edge` carries ZERO "http.handlers.waf" lines
	# (0 over 15 minutes while 71 KB accumulated in waf.log). That is the one thing to know before
	# debugging the WAF from container logs, because the stdout that remains is the per-transaction
	# AUDIT record only, which names no rule id in its own `msg` — so a WAF that is detecting
	# normally looks, from `docker compose logs edge` alone, exactly like a WAF that has stopped.
	# Read /var/log/caddy/waf.log (or the `coraza_rule_detections_total` counter) instead:
	#   docker run --rm -v opengatewayinfrastructure_edge_logs:/d alpine tail -f /d/waf.log
	#
	# `mode 0644` is load-bearing: Caddy writes log files 0600 by default and the collector runs as
	# a different uid, so without it the tail fails with EACCES and the block-rate counter silently
	# stays at zero — the exact invisibility R16 is about.
	log waf {
		include http.handlers.waf
		output file /var/log/caddy/waf.log {
			mode 0644
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}

# ── Shared site body ───────────────────────────────────────────────────────────
# args[0] = in-network upstream host:port.
(edge_site) {
	tls internal

	# Access log. Caddy does NOT log requests unless a site asks it to — the global `log` block only
	# configures the default sink, it does not turn access logging on. This is the line WP20's trace
	# id has to appear on.
	log

	coraza_waf {
		load_owasp_crs
		directives `
		Include @coraza.conf-recommended
		Include @crs-setup.conf.example

		# Paranoia level 1 — CRS's own default, set explicitly so a CRS bump cannot move it.
		SecAction "id:900000,phase:1,nolog,pass,t:none,setvar:tx.blocking_paranoia_level=1"

		# EDGE_BODY_LIMIT = 10 MB (10485760 bytes). One constant for both directives, because
		# Coraza parses a non-file body fully into memory and its own default is ~128 MB.
		# WP15a caps every per-API request-size limit at <= this number at write time, so the
		# gateway is always the smaller enforcer and the edge never silently pre-empts it.
		# Changing this number means changing WP15a's DTO bound in the same commit.
		SecRequestBodyLimit 10485760
		SecRequestBodyNoFilesLimit 10485760

		Include @owasp_crs/*.conf

		# Detect-first rollout. The WAF evaluates every rule and logs every hit but blocks
		# nothing. The flip to "SecRuleEngine On" happens at WP20's exit — after a week of
		# clean DetectionOnly on real traffic AND once WP20's block-rate counter exists,
		# because a WAF block never reaches Tyk and is otherwise invisible. Do not flip it
		# here, and do not add a toggle that defaults to blocking.
		# (No backticks in this block: one would close the directives string above.)
		SecRuleEngine DetectionOnly

		# Two separate outputs, and WP20 needs to know which is which in this build.
		# (Still no backticks anywhere in this block — one closes the directives string.)
		#
		#   - Per-rule DETECTIONS go to Caddy's own logger, "http.handlers.waf", one JSON line
		#     per matched rule carrying [id], [msg], [severity], [tag "paranoia-level/N"] and
		#     the matched data. Verified on coraza-caddy 2.6.1 / CRS 4.25.0: a request whose
		#     id parameter is a classic OR-1-equals-1 string yields 942100 (libinjection SQLi,
		#     severity critical) and 949110 (Inbound Anomaly Score Exceeded) while STILL
		#     returning 200, because the engine is DetectionOnly. This is the feed to scrape.
		#
		#   - The AUDIT record below is the per-transaction envelope, and it still goes to
		#     stdout. CORRECTED at WP20 by a same-transaction capture of both sinks on this
		#     build: its "messages" is NOT null. It is a populated array, one entry per matched
		#     rule; what is empty is each entry's "message" field and the top-level
		#     "highest_severity", while the rule id lives in the entry's "error_message"
		#     ([id "942100"], [id "949110"]). "is_interrupted" is false, correctly, because the
		#     engine is DetectionOnly.
		#
		#     So the counter COULD have been built here. It is built on the per-rule logger
		#     above anyway, and that is still the right choice: one flat line per rule beats
		#     digging a rule id out of a nested array inside a multi-KB envelope, and it is what
		#     the collector's filelog+regex pipeline consumes. Note "SecAuditLogParts" below
		#     decides what the envelope carries, so dropping a part can empty it again.
		SecAuditEngine RelevantOnly
		SecAuditLogType Serial
		SecAuditLog /dev/stdout
		SecAuditLogFormat json
		SecAuditLogParts ABIJDEFHZ
		`
	}

	# `route` rather than bare directives: it pins the written order, and three things below depend
	# on running in exactly this sequence.
	route {
		# WP20 — one OTel span per edge request, exported to the collector (OTEL_* env in compose).
		# The span is the smaller half of what this buys: the module INJECTS the resulting W3C
		# `traceparent` into the request headers, so Tyk continues this trace instead of starting
		# its own and the whole edge -> gateway -> api -> postgres chain lands under one trace id.
		# Without it the chain breaks at the first hop the moment the edge is in the path. It must
		# run before the two `log_append`s, which read the header it writes.
		tracing {
			span edge
		}

		# A request id the edge owns. GENERATED, never forwarded from the client, for the same
		# reason `header_up X-Forwarded-For` below REPLACES rather than appends: a client-supplied
		# id lets a caller collide with or poison the identifier every downstream log line is keyed
		# on. The API reads it back as pino's reqId (apps/api/src/app.module.ts).
		request_header X-Request-Id {http.request.uuid}

		# Both ids as explicit access-log FIELDS. `request.headers` in the log line is not enough:
		# Caddy records the headers as RECEIVED, so neither the id set just above nor the
		# traceparent injected by `tracing` appears there — verified, both were absent. These two
		# lines are what actually puts the trace id on the edge's access-log line and make it
		# joinable to the Tyk span and the api span.
		log_append request_id {http.request.uuid}
		log_append traceparent {http.request.header.traceparent}

		# WP20: /api/metrics is Prometheus' in-network scrape target (api:4000/api/metrics). It
		# carries no secret but it does describe the deployment, and nothing outside this network
		# has a reason to read it. Matched on every site, not just the api one, so a future site
		# cannot publish it by accident.
		respond /api/metrics* 404

		reverse_proxy {args[0]} {
			# REPLACE, not append. Caddy's default appends the peer to whatever the client sent, so
			# a forged X-Forwarded-For would survive into the header the API reads. The API runs
			# `trust proxy = TRUST_PROXY_HOPS` (=1), which takes the LAST entry — this directive is
			# what makes that entry the real client instead of the client's own claim.
			#
			# `caddy validate` prints "Unnecessary header_up X-Forwarded-For" here. That lint is
			# wrong for this case and the line is load-bearing: `caddy adapt` shows the directive
			# produces `{"set": {"X-Forwarded-For": ["{http.request.remote.host}"]}}` — a set, not
			# the default `add`. Deleting it restores the append and reopens the spoof.
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# ── Internal listener (OG-OBS-02) ───────────────────────────────────────────────
# Unpublished: obs-w2's compose change is `expose: 9180`, never `ports:`. That means it is reachable
# only from containers on this edge's own Docker networks (open-gateway-network, ory-internal) —
# never from the LAN or the host. No `tls internal` and no `coraza_waf` here, unlike every site
# above: this is not a client-facing surface, so terminating TLS and running the WAF on it would add
# attack surface without protecting anything. `:2019` (the Caddy admin API) is untouched by this
# block and stays in-container, loopback-only, exactly as before.
#
# This is the ONLY place Caddy's request metrics and the Ory admin metrics/health routes are
# reachable from — which makes the allowlist below the actual security boundary between Prometheus
# and the unauthenticated Hydra/Kratos/Keto admin APIs on `ory-internal` (ADR-OBS-04). The
# alternative — Prometheus joining `ory-internal` directly — would hand it those APIs whole; this
# listener hands it six fixed paths instead. Read top to bottom:
#   1. Any method other than GET/HEAD is refused, unconditionally, before anything else runs: 405.
#   2. Exactly six proxied paths are recognised, each pinned to one upstream host:port and rewritten
#      to that service's own fixed metrics/health path. No wildcard, no prefix match.
#   3. Everything else — any other path, including the Ory admin APIs' real routes such as
#      `/admin/clients` — falls through to the unconditional `respond 404` at the end.
http://:9180 {
	route {
		@not_get_head {
			not method GET HEAD
		}
		respond @not_get_head 405

		# Caddy's own request metrics — fed by the `metrics` global option set above.
		metrics /metrics

		# Hydra admin API, :4445 (loopback-only on the host; reachable here because this container
		# shares `ory-internal` with hydra). Hydra is the one Ory service here whose metrics path
		# keeps an `/admin` prefix — verified against Ory's docs, 2026-09-27.
		reverse_proxy /ory/hydra/metrics hydra:4445 {
			rewrite /admin/metrics/prometheus
		}
		reverse_proxy /ory/hydra/health hydra:4445 {
			rewrite /health/ready
		}

		# Kratos admin API, :4434. Its metrics path has NO `/admin` prefix, unlike Hydra's — verified
		# against Ory's docs, 2026-09-27. This differs from an earlier draft of this contract; see
		# the worker report for the correction.
		reverse_proxy /ory/kratos/metrics kratos:4434 {
			rewrite /metrics/prometheus
		}
		reverse_proxy /ory/kratos/health kratos:4434 {
			rewrite /health/ready
		}

		# Keto health lives on the read API (:4466 — matches Keto's own compose healthcheck), but its
		# Prometheus metrics do not: Keto splits metrics onto their own port, :4468, configured in
		# `infra/ory/keto/keto.yml`'s `serve.metrics` block. Verified against that file plus Ory's
		# docs, 2026-09-27; :4466 would 404 for `/metrics/prometheus` against the real service. This
		# also differs from an earlier draft of this contract; see the worker report.
		reverse_proxy /ory/keto/metrics keto:4468 {
			rewrite /metrics/prometheus
		}
		reverse_proxy /ory/keto/health keto:4466 {
			rewrite /health/ready
		}

		respond 404
	}
}

# ── Sites ──────────────────────────────────────────────────────────────────────
# EDGE_LAN_IP is the host's LAN address (infra/.env). Unset, the site still answers on loopback.

localhost:33000, {$EDGE_LAN_IP:127.0.0.1}:33000 {
	import edge_site web:3000
}

localhost:33001, {$EDGE_LAN_IP:127.0.0.1}:33001 {
	import edge_site api:4000
}

# Tyk DATA plane only. The control API is a separate port (8081) inside the network.
#
# WP27: NOT `import edge_site` like the other four sites. gRPC (h2c, HTTP/2 cleartext) is proxied
# through this port and needs `transport http { versions h2c 2 }` on the reverse_proxy toward Tyk —
# live-verified (grpcurl through a throwaway grpcbin fixture): without it, Caddy accepts the
# client's HTTP/2 request and Tyk logs "Enabling h2c mode" correctly, but the call hangs and the
# edge eventually logs "failed to append request body: client disconnected", 500 — Caddy's default
# reverse_proxy transport to a plain-HTTP backend is HTTP/1.1, which cannot carry gRPC's framing or
# trailers. Setting `versions h2c 2` on the SHARED `edge_site` snippet would apply it to all five
# sites, and web/api/hydra/kratos do not speak h2c — that would break them, not fix this one. The
# body below is otherwise an exact copy of `edge_site` (same WAF, tracing, logging, XFF handling);
# keep the two in sync by hand if either changes.
localhost:33005, {$EDGE_LAN_IP:127.0.0.1}:33005 {
	tls internal

	log

	coraza_waf {
		load_owasp_crs
		directives `
		Include @coraza.conf-recommended
		Include @crs-setup.conf.example

		SecAction "id:900000,phase:1,nolog,pass,t:none,setvar:tx.blocking_paranoia_level=1"

		SecRequestBodyLimit 10485760
		SecRequestBodyNoFilesLimit 10485760

		Include @owasp_crs/*.conf

		SecRuleEngine DetectionOnly

		SecAuditEngine RelevantOnly
		SecAuditLogType Serial
		SecAuditLog /dev/stdout
		SecAuditLogFormat json
		SecAuditLogParts ABIJDEFHZ
		`
	}

	route {
		tracing {
			span edge
		}

		request_header X-Request-Id {http.request.uuid}

		log_append request_id {http.request.uuid}
		log_append traceparent {http.request.header.traceparent}

		# WP29a: WHICH gateway node served this request. Only on this site — the other four have a
		# single upstream — and once there are three nodes it is the only way to answer "node 2 is
		# returning 502s" from the edge's own log. The placeholder resolves after `reverse_proxy`
		# has chosen, so it names the upstream actually dialled, not the first candidate.
		log_append upstream {http.reverse_proxy.upstream.hostport}

		respond /api/metrics* 404

		# WP29a: every gateway NODE, by name. `EDGE_GATEWAY_UPSTREAMS` is a space-separated list and
		# Caddy expands env placeholders in the raw file before it tokenises, so the value becomes
		# several upstream arguments rather than one — `tyk-gateway:8080 tyk-gateway-2:8080
		# tyk-gateway-3:8080` is three upstreams, not one host named with spaces.
		#
		# The DEFAULT is the single node on purpose. tyk-gateway-2/3 exist only under
		# `--profile multinode`; listing them unconditionally would send a third of the data plane
		# to a name that does not resolve on a default `up`. docker-compose.prod.yml sets the full
		# list, and passes --profile multinode with it.
		#
		# Three settings, and all three are needed — measured, not copied from a guide.
		#
		#   fail_duration     takes a node that failed out of rotation for 10s.
		#   lb_try_duration   lets the request be RETRIED against a surviving node. Without it the
		#                     node is still marked down, but the request that discovered it 502s.
		#   dial_timeout      is the one that is easy to leave out and breaks the other two.
		#
		# Why dial_timeout is load-bearing here: when a gateway container is STOPPED, Docker's
		# embedded DNS does not answer NXDOMAIN for its name — the lookup HANGS. Measured on this
		# stack: `dial tcp: lookup tyk-gateway-3: i/o timeout` after 6.25 s. With the default
		# (no dial timeout) that single attempt outlives any sane lb_try_duration, so the retry
		# budget is spent before the first failure is even known and roughly one request per
		# fail_duration cycle 502s — which is exactly what the first run of this config did, 1 in
		# 40, steady state, with two of three nodes down. Capping the dial at 2 s leaves the
		# 10 s budget enough room to try the other two nodes and still answer.
		reverse_proxy {$EDGE_GATEWAY_UPSTREAMS:tyk-gateway:8080} {
			fail_duration 10s
			lb_try_duration 10s
			header_up X-Forwarded-For {remote_host}

			# WP27: h2c to the backend — see the block comment above. `2` (plain HTTP/2, no TLS) is
			# kept alongside `h2c` so a non-gRPC request negotiated as HTTP/2 by the client still
			# proxies normally; Caddy tries h2c first and this is not exclusive to gRPC traffic.
			transport http {
				versions h2c 2

				# WP29a — see the dial_timeout paragraph above the reverse_proxy line. This is the
				# cap that keeps a stopped node's hanging DNS lookup from eating the retry budget.
				dial_timeout 2s
			}
		}
	}
}

localhost:33010, {$EDGE_LAN_IP:127.0.0.1}:33010 {
	import edge_site hydra:4444
}

localhost:33012, {$EDGE_LAN_IP:127.0.0.1}:33012 {
	import edge_site kratos:4433
}

# Catch-all. Caddy's default for a request whose Host matches no site above is an EMPTY 200 — nothing
# is proxied, but the status code reads like success, which makes "is Prometheus / the Tyk control
# API / an Ory admin port reachable through the edge?" ambiguous to assert. This answers 404 instead.
# It proxies nothing; adding an upstream here would create the accidental catch-all route the WP
# exists to prevent. Caddy orders the host-matched routes above ahead of this one.
https://:33000, https://:33001, https://:33005, https://:33010, https://:33012 {
	tls internal
	respond 404
}
